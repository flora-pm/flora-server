cabal-version: 3.0
name: flora
version: 1.0.32
homepage: https://github.com/flora-pm/flora-server/#readme
bug-reports: https://github.com/flora-pm/flora-server/issues
author: Théophile Choutri
maintainer: Théophile Choutri
license: AGPL-3.0-only
build-type: Simple
extra-source-files: LICENSE
extra-doc-files:
  CHANGELOG.md
  README.md

tested-with: ghc ==9.10.3

source-repository head
  type: git
  location: https://github.com/flora-pm/flora-server

common common-extensions
  default-extensions:
    DataKinds
    DeepSubsumption
    DeriveAnyClass
    DerivingStrategies
    DerivingVia
    DuplicateRecordFields
    GADTs
    LambdaCase
    NoFieldSelectors
    NoStarIsType
    NumericUnderscores
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    PackageImports
    PolyKinds
    StrictData
    TypeData
    TypeFamilies
    UndecidableInstances
    ViewPatterns

  default-language: GHC2021

common common-ghc-options
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -fhide-source-paths
    -Wno-unused-do-bind
    -fshow-hole-constraints
    -Wno-unticked-promoted-constructors
    -fdicts-strict
    -fmax-worker-args=16
    -fspec-constr-recursive=16
    -Wunused-packages
    -flate-specialise
    -funbox-strict-fields
    -finline-generics-aggressively
    -fexpose-all-unfoldings
    -fplugin=Effectful.Plugin
    -finfo-table-map
    -fdistinct-constructor-tables

common common-rts-options
  ghc-options:
    -rtsopts
    -threaded
    "-with-rtsopts=-N -Iw1 --disable-delayed-os-memory-return -T"

  -- Use TCMalloc instead of glibc's malloc.
  if !(os(osx) && arch(aarch64))
    pkgconfig-depends: libtcmalloc

library
  import: common-extensions
  import: common-ghc-options
  hs-source-dirs:
    ./src/core
    ./src/datatypes

  other-modules:
