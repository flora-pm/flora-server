flora {
  domain localhost
  httpPort 8084
  environment development
  db {
    host "flora-database"
    port 5432
    user "postgres"
    password "postgres"
    dbname "flora_dev_1"
  }

  pool {
    timeout 10
    connections 50
    importWorkers 4
  }

  mltp {
    sentryDSN ""
    prometheusEnabled #true
    loggingDestination stdout
    eventlogSocketDirectory "/tmp/flora-eventlog"
  }

  features {
    tarballsEnabled #false
    blobStoreFilePath #null
  }
}
