jobs-runner {
  domain localhost
  httpPort 8086
  webHttpPort 8084
  environment test
  db {
    host "flora-database"
    port 5432
    user "postgres"
    password "postgres"
    dbname "flora_test"
    sslmode "allow"
  }

  pool {
    timeout 10
    connections 15
    importWorkers 6
  }


  mltp {
    sentryDSN ""
    prometheusEnabled #false
    loggingDestination stdout
  }

  features {
    tarballsEnabled #false
    blobStoreFilePath #null
  }
}
