flora {
  domain localhost
  httpPort 8083
  jobsHttpPort 8085
  environment test
  db {
    host "localhost"
    port 5432
    user "postgres"
    password "postgres"
    dbname "flora_test"
  }

  pool {
    timeout 10
    connections 20
    importWorkers 4
  }

  mltp {
    sentryDSN ""
    prometheusEnabled #false
    loggingDestination stdout
    eventlogSocketDirectory "/tmp/flora-eventlog"
  }

  features {
    tarballsEnabled #false
    blobStoreFilePath #null
  }
}
