flora {
  domain localhost
  httpPort 8085
  webHttpPort 8083
  environment test
  db {
    host "localhost"
    port 5432
    user "postgres"
    password "postgres"
    dbname "flora_test"
  }

  pool {
    timeout 10
    connections 20
    importWorkers 4
  }

  mltp {
    sentryDSN ""
    prometheusEnabled #false
    loggingDestination stdout
  }

  features {
    tarballsEnabled #false
    blobStoreFilePath #null
  }
}
