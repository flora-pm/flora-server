packages:
    ./

with-compiler: ghc-9.10.3

active-repositories: hackage.haskell.org

tests: True

test-show-details: direct

build-info: True

jobs: $ncpus

package *
  ghc-options: +RTS -I0 -RTS -finfo-table-map -fdistinct-constructor-tables -fwrite-ide-info

index-state: 2026-10-29T11:25:04Z

allow-newer: hsec-tools:pandoc

constraints:
  , any.Cabal ==3.16.1.0
  , any.Cabal-syntax ==3.16.1.0
  , any.crypton ==2.1.8

package feed
  ghc-options: -Wno-tabs

package warp
  flags: -x509

package zlib
  flags: -pkg-config

package async
  flags: +debug-auto-label

source-repository-package
  type: git
  location: https://github.com/haskell/security-advisories
  tag: f4418546ae5a26d7c725f5687a7e7197d406b004
  subdir:
    code/cvss
    code/hsec-core
    code/hsec-tools
    code/osv

