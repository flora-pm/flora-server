packages:
    ./

with-compiler: ghc-9.10.3

active-repositories: hackage.haskell.org

tests: True

test-show-details: direct

jobs: $ncpus

package *
  ghc-options: +RTS -I0 -RTS -finfo-table-map -fdistinct-constructor-tables -fwrite-ide-info

allow-newer: chronos:hashable
           , feed:*
           , insert-ordered-containers:hashable
           , prometheus-effectful:bytestring
           , prometheus-effectful:effectful
           , prometheus-proc:*
           , qrcode-core:*
           , qrcode-juicypixels:*
           , servant-lucid:text
           , tasty-test-reporter:*
           , wai-middleware-heartbeat:*
           , pandoc-types:QuickCheck
           , pg-entity:resource-pool
           , arbiter:resource-pool
           , xss-sanitize:text

package feed
  ghc-options: -Wno-tabs

package warp
  flags: -x509

package zlib
  flags: -pkg-config

package effectful-tracing
  flags: +otel +servant +postgresql-simple

package async
  flags: +debug-auto-label

