{
  "license": "AGPL-3.0-only",
  "source": [
    "css/styles.css",
    "js/*",
    "files/**"
  ],
  "targets": {
    "default": {
      "distDir": "../static",
      "publicUrl": "/static/"
    }
  },
  "devDependencies": {
    "@parcel/config-default": "^2.16.4",
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/packager-xml": "^2.16.4",
    "@parcel/plugin": "^2.16.4",
    "@parcel/transformer-raw": "^2.16.4",
    "@parcel/transformer-webmanifest": "^2.16.4",
    "@parcel/transformer-xml": "^2.16.4",
    "parcel": "^2.16.4",
    "parcel-reporter-bundle-manifest": "^1.0.0",
    "process": "^0.11.10",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^36.0.1"
  },
  "dependencies": {
    "@oddbird/css-anchor-positioning": "^0.10.2",
    "@oddbird/popover-polyfill": "^0.6.1",
    "alpinejs": "^3.14.9",
    "htmx.org": "^2.0.2",
    "interestfor": "^1.0.10"
  },
  "scripts": {
    "watch": "yarn clean:build && parcel watch",
    "build": "yarn clean:build && parcel build --no-cache",
    "clean:artifacts": "if [ -d '../static/' ]; then rm -R ../static/*; fi",
    "clean:cache": "if [ -d './.parcel-cache/' ]; then rm -R ./.parcel-cache/*; fi",
    "clean:modules": "if [ -d './node_modules/' ]; then rm -R ./node_modules/*; fi",
    "clean:build": "yarn clean:artifacts && yarn clean:cache",
    "clean:all": "yarm clean:modules && yarn clean:build"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
