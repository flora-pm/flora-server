# syntax=docker/dockerfile:1.7

# Stage 1: Builder
FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818 AS builder
ARG GHC_VERSION=9.10.3
ARG CABAL_VERSION=3.16.1.0
ENV LANG=en_GB.UTF-8 \
    BOOTSTRAP_HASKELL_NONINTERACTIVE=1 \
    BOOTSTRAP_HASKELL_GHC_VERSION=${GHC_VERSION} \
    BOOTSTRAP_HASKELL_CABAL_VERSION=${CABAL_VERSION} \
    BOOTSTRAP_HASKELL_INSTALL_NO_STACK=1 \
    GHCUP_INSTALL_BASE_PREFIX=/opt/ghcup \
    CABAL_DIR=/root/.cabal \
    PATH=/opt/ghcup/.ghcup/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl git libffi-dev libgmp-dev libncurses-dev \
    libpq-dev libsodium-dev libgoogle-perftools-dev pkg-config zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://get-ghcup.haskell.org | sh
WORKDIR /src

# Resolve and build dependencies first, keyed only on the package metadata,
# so source edits don't re-trigger `cabal update` or dependency resolution.
COPY cabal.project cabal.project.freeze flora.cabal ./
RUN --mount=type=cache,target=/root/.cabal \
    --mount=type=cache,target=/src/dist-newstyle \
    . /opt/ghcup/.ghcup/env && \
    cabal update && \
    cabal build --only-dependencies \
      exe:flora-server exe:flora-migrate exe:flora-cli exe:flora-jobs-runner

COPY . .
RUN --mount=type=cache,target=/root/.cabal \
    --mount=type=cache,target=/src/dist-newstyle \
    . /opt/ghcup/.ghcup/env && \
    cabal install exe:flora-server exe:flora-migrate exe:flora-cli exe:flora-jobs-runner \
      --installdir=/out --install-method=copy --overwrite-policy=always && \
    strip /out/flora-server /out/flora-jobs-runner

# Stage 2: Frontend
FROM node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0 AS frontend
WORKDIR /src
COPY assets ./assets
COPY docs ./docs
# NOTE: no manifest/node_modules layer split; assets are small, so a reinstall
# on every source change is cheap enough for now.
RUN cd assets && yarn install --frozen-lockfile && yarn build
RUN cd docs && yarn install --frozen-lockfile && yarn build

# Stage 3: Runtime
FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION
LABEL org.opencontainers.image.created=${BUILD_DATE} \
      org.opencontainers.image.revision=${VCS_REF} \
      org.opencontainers.image.version=${VERSION} \
      org.opencontainers.image.source=https://github.com/flora-pm/flora-server
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libffi8 libgmp10 libncurses6 libpq5 libsodium23 \
    libtinfo6 libgoogle-perftools4 \
    && rm -rf /var/lib/apt/lists/*
RUN useradd -m -u 1000 flora
COPY --from=builder /out/flora-server /usr/local/bin/
COPY --from=builder /out/flora-migrate /usr/local/bin/
COPY --from=builder /out/flora-cli /usr/local/bin/
COPY --from=builder /out/flora-jobs-runner /usr/local/bin/
COPY --from=builder /src/scripts /scripts
COPY --from=builder /src/migrations /migrations
COPY --from=frontend /src/static /static
COPY --from=frontend /src/docs/build /docs/build
WORKDIR /
USER flora
EXPOSE 8084
ENTRYPOINT ["flora-server", "-c", "/flora.kdl"]
